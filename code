    if (!SR) { addLocalLine('Speech recognition is not available in this browser. Type in the box instead, or use Chrome or Edge.'); return; }
    if (S.micOn) { S.micOn = false; try { S.recog.stop(); } catch (e) { /* already stopped */ } btn.className = ''; return; }
