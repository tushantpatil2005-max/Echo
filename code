.peer.presenting { border-color: var(--accent); }
#bar a { color: var(--accent); font-size: 14px; }
#followBanner { display: flex; align-items: center; gap: 10px; padding: 6px 12px; background: var(--accent); color: var(--accent-ink); font-size: 14px; }
#followBanner button { min-height: 28px; padding: 2px 10px; background: transparent; color: inherit; border-color: currentColor; }

#main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }
#stage { position: relative; min-height: 0; min-width: 0; }
#board { width: 100%; height: 100%; display: block; touch-action: none; cursor: grab;
  background-image: radial-gradient(var(--grid) 1px, transparent 1px); background-size: 24px 24px; }
#toolbar { position: absolute; left: 12px; bottom: 12px; display: flex; gap: 6px; flex-wrap: wrap; max-width: calc(100% - 24px); }
#toolbar button { box-shadow: var(--shadow); }
#empty { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; text-align: center; color: var(--muted); padding: 24px; }
#empty div { max-width: 420px; }
#empty strong { display: block; color: var(--ink); font: 700 22px/1.2 Charter, "Iowan Old Style", Georgia, serif; margin-bottom: 6px; }

#side { display: flex; flex-direction: column; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }
#videos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; padding: 8px; }
.tile { position: relative; aspect-ratio: 16 / 10; background: #101214; border-radius: 8px; overflow: hidden; display: grid; place-items: center; color: #fff; }
.tile video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.tile .who { position: absolute; left: 6px; bottom: 4px; font-size: 12px; background: rgba(0,0,0,.55); padding: 0 6px; border-radius: 4px; }
.tile .avatar { font: 700 26px/1 Charter, Georgia, serif; opacity: .8; }
#media { display: flex; gap: 6px; padding: 0 8px 8px; flex-wrap: wrap; }
#media button { flex: 1; font-size: 13px; padding: 4px 8px; }
#log { flex: 1; overflow-y: auto; padding: 8px 12px; border-top: 1px solid var(--line); min-height: 80px; }
.line { margin: 0 0 6px; font-size: 14px; overflow-wrap: anywhere; }
.line .sp { font-weight: 700; margin-right: 6px; }
.line.echo { color: var(--accent); }
.line.command .tx { font-style: italic; }
.line.local { color: var(--muted); font-style: italic; }
#chatForm { display: flex; gap: 6px; padding: 8px; border-top: 1px solid var(--line); }
#hint { padding: 0 12px 10px; font-size: 12px; color: var(--muted); }

.node { cursor: pointer; }
.node rect.body { stroke: rgba(0,0,0,.25); stroke-width: 1; }
.node text { fill: var(--node-fg); font: 13px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; pointer-events: none; }
.node text.badge { font-size: 10px; letter-spacing: .08em; opacity: .7; font-weight: 700; }
.node text.meta { font-size: 11px; opacity: .8; }
.node.selected rect.body { stroke: var(--accent); stroke-width: 3; }
.node rect.peersel { fill: none; stroke-width: 3; pointer-events: none; }
.n-topic rect.body { fill: var(--topic-bg); } .n-topic text { fill: var(--topic-fg); }
.n-idea rect.body { fill: var(--idea); } .n-question rect.body { fill: var(--question); } .n-decision rect.body { fill: var(--decision); }
.n-task rect.body { fill: var(--task); } .n-problem rect.body { fill: var(--problem); } .n-note rect.body { fill: var(--note); }
.n-step rect.body { fill: var(--step); } .n-summary rect.body { fill: var(--summary); }
.edge { fill: none; stroke: var(--muted); stroke-width: 1.6; opacity: .8; }
.edge.link { stroke-dasharray: 6 5; }
.edgelabel { fill: var(--muted); font: 11px system-ui, sans-serif; text-anchor: middle; }
.group rect { fill: var(--accent); fill-opacity: .06; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 8 6; }
.group text { fill: var(--accent); font: 700 13px system-ui, sans-serif; }
.cursor path { stroke: #fff; stroke-width: 1; }
.cursor text { font: 700 11px system-ui, sans-serif; fill: #fff; }
#arrow path { fill: var(--muted); }

@media (max-width: 800px) {
  #main { grid-template-columns: 1fr; grid-template-rows: 1fr 46%; }
  #side { border-left: 0; border-top: 1px solid var(--line); }
  #videos { grid-template-columns: repeat(4, 1fr); }
}
</style>
</head>
<body>
<div id="join" class="overlay" hidden>
  <form id="joinForm" class="card">
    <h1>Echo</h1>
    <p>Talk it through. The canvas builds itself.</p>
    <label for="joinRoom">Room</label>
    <input id="joinRoom" maxlength="40" autocomplete="off" spellcheck="false">
    <label for="joinName">Your name</label>
    <input id="joinName" maxlength="30" autocomplete="nickname">
    <button class="primary" type="submit">Join the room</button>
  </form>
</div>

<div id="app" hidden>
  <header id="bar">
    <span class="logo">Echo</span>
    <span id="roomName"></span>
    <span id="status"></span>
    <button id="btnCopy" type="button">Copy invite link</button>
    <button id="btnPresent" type="button">Present</button>
    <a id="exportLink" target="_blank" rel="noopener">Export summary</a>
    <span id="peers"></span>
  </header>
  <div id="followBanner" hidden><span id="followText"></span><button id="btnFollow" type="button">Stop following</button></div>
  <div id="main">
    <div id="stage">
      <svg id="board" xmlns="http://www.w3.org/2000/svg" role="application" aria-label="Shared canvas">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z"></path></marker>
        </defs>
        <g id="view"><g id="groups"></g><g id="edges"></g><g id="nodes"></g><g id="cursors"></g></g>
      </svg>
      <div id="empty"><div><strong>Start talking.</strong>Turn on Transcribe, or type below. Try: &ldquo;Let&rsquo;s talk about pricing. The problem is that plans are confusing.&rdquo;</div></div>
      <div id="toolbar">
        <button type="button" data-add="idea">+ Idea</button>
        <button type="button" data-add="question">+ Question</button>
        <button type="button" data-add="decision">+ Decision</button>
        <button type="button" data-add="task">+ Task</button>
        <button type="button" data-add="problem">+ Problem</button>
        <button type="button" data-add="note">+ Note</button>
        <button type="button" id="btnUndo">Undo</button>
        <button type="button" id="btnFit">Fit</button>
      </div>
    </div>
    <aside id="side">
      <div id="videos"></div>
      <div id="media">
        <button type="button" id="btnCam">Camera</button>
        <button type="button" id="btnMic">Mic</button>
        <button type="button" id="btnTranscribe">Transcribe</button>
      </div>
      <div id="log" aria-live="polite"></div>
      <form id="chatForm">
        <input id="chatInput" maxlength="1000" autocomplete="off" placeholder="Say it in text, or: echo group these ideas">
        <button class="primary" type="submit">Send</button>
      </form>
      <div id="hint">Select items, then say &ldquo;echo, group these ideas&rdquo; or &ldquo;echo, visualize this&rdquo;. Drag to move, double-click to edit, Delete to remove.</div>
    </aside>
  </div>
</div>

<script nonce="__NONCE__">
(function () {
  'use strict';
  var W = 240, H = 84, SVGNS = 'http://www.w3.org/2000/svg';
  var TYPE_LABEL = { topic: 'TOPIC', idea: 'IDEA', question: 'QUESTION', decision: 'DECISION', task: 'TASK', problem: 'PROBLEM', note: 'NOTE', step: 'STEP', summary: 'SUMMARY' };

  function $(id) { return document.getElementById(id); }
  function setAttrs(e, a) { for (var k in a) { if (a[k] !== null && a[k] !== undefined) e.setAttribute(k, String(a[k])); } }
  function svg(name, attrs, parent, text) {
    var e = document.createElementNS(SVGNS, name);
    setAttrs(e, attrs || {});
    if (text !== undefined && text !== null) e.textContent = text;
    if (parent) parent.appendChild(e);
    return e;
  }
  function html(name, cls, parent, text) {
    var e = document.createElement(name);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null) e.textContent = text;
    if (parent) parent.appendChild(e);
    return e;
  }
  function clear(e) { while (e.firstChild) e.removeChild(e.firstChild); }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function now() { return Date.now(); }

  var S = {
    ws: null, me: null, room: '', name: '', retry: 0, fatal: false, timer: null,
    peers: {}, canvas: { nodes: {}, edges: {}, groups: {}, topic: null }, transcript: [],
    presenterId: null, following: false, view: { x: 40, y: 40, k: 1 },
    selection: {}, peerSel: {}, cursors: {},
    ice: null, pcs: {}, local: { audio: null, video: null }, tiles: {}, recog: null, micOn: false
  };
  var board = $('board'), layerView = $('view'), layerGroups = $('groups'), layerEdges = $('edges'), layerNodes = $('nodes'), layerCursors = $('cursors');
  var nodeEls = {};

  // ---------------------------------------------------------------- connection
  function send(obj) { if (S.ws && S.ws.readyState === 1) S.ws.send(JSON.stringify(obj)); }

  function setStatus(text, bad) { var s = $('status'); s.textContent = text; s.className = bad ? 'bad' : ''; }

  function connect() {
    var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
    var ws = new WebSocket(proto + location.host + '/ws');
    S.ws = ws;
    ws.onopen = function () { S.retry = 0; setStatus('connected'); send({ t: 'join', room: S.room, name: S.name }); };
    ws.onmessage = function (ev) {
      var m;
      try { m = JSON.parse(ev.data); } catch (e) { return; }
      if (m && typeof m === 'object') handle(m);
    };
    ws.onclose = function () {
      closeAllCalls();
      if (S.fatal) return;
      setStatus('reconnecting...', true);
      var delay = Math.min(10000, 500 * Math.pow(2, S.retry++));
      S.timer = setTimeout(connect, delay);
    };
  }

  function handle(m) {
    switch (m.t) {
      case 'welcome':
        S.me = m.you; S.canvas = m.canvas; S.transcript = m.transcript || []; S.presenterId = m.presenterId || null; S.ice = m.ice || null;
        S.peers = {}; (m.peers || []).forEach(function (p) { S.peers[p.id] = p; });
        S.cursors = {}; S.peerSel = {};
        S.following = !!(S.presenterId && S.presenterId !== S.me.id);
        renderBoard(); renderLog(); renderPeers(); renderBanner(); renderTiles();
        if (m.view && S.following) applyView(m.view);
        closeAllCalls();
        Object.keys(S.peers).forEach(function (id) { startCall(id, true); });
        sendMedia();
        break;
      case 'peer.join': S.peers[m.peer.id] = m.peer; renderPeers(); renderTiles(); break;
      case 'peer.update': S.peers[m.peer.id] = m.peer; renderPeers(); renderTiles(); break;
      case 'peer.leave':
        delete S.peers[m.id]; delete S.cursors[m.id]; delete S.peerSel[m.id];
        closeCall(m.id); renderPeers(); renderTiles(); renderCursors(); applySelection();
        break;
      case 'cursor': S.cursors[m.id] = { x: m.x, y: m.y, t: now() }; renderCursors(); break;
      case 'select': S.peerSel[m.id] = m.ids || []; applySelection(); break;
      case 'canvas':
        S.canvas = m.canvas;
        Object.keys(S.selection).forEach(function (id) { if (!S.canvas.nodes[id]) delete S.selection[id]; });
        renderBoard();
        break;
      case 'move':
        (m.moves || []).forEach(function (mv) { var n = S.canvas.nodes[mv.id]; if (n && !(drag && drag.mode === 'node' && S.selection[mv.id])) { n.x = mv.x; n.y = mv.y; n.pinned = true; } });
        positionNodes();
        break;
      case 'transcript': S.transcript.push(m.entry); addLogLine(m.entry); break;
      case 'presenter':
        S.presenterId = m.id;
        S.following = !!(m.id && S.me && m.id !== S.me.id);
        renderBanner(); renderPeers();
        break;
      case 'view': if (S.following) applyView(m); break;
      case 'signal': handleSignal(m.from, m.data); break;
      case 'notice': addLocalLine(m.text); break;
      case 'error':
        S.fatal = true; setStatus(m.message || 'Could not join this room', true); addLocalLine(m.message || 'Could not join this room');
        break;
      default: break;
    }
  }

  // ---------------------------------------------------------------- view transform
  var viewTimer = null;
function viewCenter() {
    var r = board.getBoundingClientRect();
    return { x: (r.width / 2 - S.view.x) / S.view.k, y: (r.height / 2 - S.view.y) / S.view.k };
  }
  function applyTransform() {
    layerView.setAttribute('transform', 'translate(' + S.view.x + ',' + S.view.y + ') scale(' + S.view.k + ')');
    if (S.me && S.presenterId === S.me.id && !viewTimer) {
      viewTimer = setTimeout(function () {
        viewTimer = null;
        var c = viewCenter();
        send({ t: 'view', x: c.x, y: c.y, zoom: S.view.k });
      }, 60);
    }
  }
  function applyView(v) {
    var r = board.getBoundingClientRect();
    S.view.k = clamp(v.zoom, 0.15, 3);
    S.view.x = r.width / 2 - v.x * S.view.k;
    S.view.y = r.height / 2 - v.y * S.view.k;
    applyTransform();
  }
  function toCanvas(e) {
    var r = board.getBoundingClientRect();
    return { x: (e.clientX - r.left - S.view.x) / S.view.k, y: (e.clientY - r.top - S.view.y) / S.view.k };
  }
  function fit() {
    var ns = Object.keys(S.canvas.nodes).map(function (id) { return S.canvas.nodes[id]; });
    if (!ns.length) { S.view = { x: 40, y: 40, k: 1 }; applyTransform(); return; }
    var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    ns.forEach(function (n) { minX = Math.min(minX, n.x); minY = Math.min(minY, n.y); maxX = Math.max(maxX, n.x + W); maxY = Math.max(maxY, n.y + H); });
    var r = board.getBoundingClientRect();
    var k = clamp(Math.min((r.width - 80) / (maxX - minX), (r.height - 120) / (maxY - minY)), 0.15, 1.2);
    S.view.k = k;
    S.view.x = (r.width - (maxX - minX) * k) / 2 - minX * k;
    S.view.y = (r.height - (maxY - minY) * k) / 2 - minY * k;
    applyTransform();
  }

  // ---------------------------------------------------------------- canvas rendering
  function wrap(text, maxChars, maxLines) {
    var words = String(text).split(/\s+/), lines = [], cur = '';
    for (var i = 0; i < words.length; i++) {
      var w = words[i];
      if (w.length > maxChars) w = w.slice(0, maxChars - 1) + '\u2026';
      if (cur && (cur + ' ' + w).length > maxChars) { lines.push(cur); cur = w; } else { cur = cur ? cur + ' ' + w : w; }
    }
    if (cur) lines.push(cur);
    if (lines.length > maxLines) { lines = lines.slice(0, maxLines); lines[maxLines - 1] = lines[maxLines - 1].replace(/.{0,1}$/, '') + '\u2026'; }
    return lines;
  }

  function drawNode(n) {
    var g = svg('g', { 'class': 'node n-' + n.type, 'data-id': n.id, transform: 'translate(' + n.x + ',' + n.y + ')' }, layerNodes);
    svg('rect', { 'class': 'body', width: W, height: H, rx: 10 }, g);
    svg('text', { 'class': 'badge', x: 12, y: 17 }, g, TYPE_LABEL[n.type] || n.type.toUpperCase());
    var lines = wrap(n.text, 33, n.type === 'summary' ? 4 : 3);
    for (var i = 0; i < lines.length; i++) svg('text', { x: 12, y: 36 + i * 16 }, g, lines[i]);
    var meta = [];
    if (n.meta && n.meta.owner) meta.push(n.meta.owner);
    if (n.meta && n.meta.due) meta.push('due ' + n.meta.due);
    if (!meta.length && n.by) meta.push(n.by);
    if (meta.length) svg('text', { 'class': 'meta', x: 12, y: H - 8 }, g, meta.join(' \u00b7 '));
    if (n.mentions > 1) {
      svg('circle', { cx: W - 14, cy: 14, r: 10, fill: 'rgba(0,0,0,.35)' }, g);
      svg('text', { x: W - 14, y: 18, 'text-anchor': 'middle', fill: '#fff' }, g, 'x' + n.mentions);
    }
    return g;
  }

  function nodeBox(n) { return { x: n.x, y: n.y, w: W, h: H }; }
  function edgePath(a, b, kind) {
    var A = nodeBox(a), B = nodeBox(b);
    if (kind === 'child' && B.x > A.x + A.w - 10) {
      var x1 = A.x + A.w, y1 = A.y + A.h / 2, x2 = B.x, y2 = B.y + B.h / 2, dx = Math.max(40, (x2 - x1) / 2);
      return { d: 'M' + x1 + ',' + y1 + ' C' + (x1 + dx) + ',' + y1 + ' ' + (x2 - dx) + ',' + y2 + ' ' + x2 + ',' + y2, mx: (x1 + x2) / 2, my: (y1 + y2) / 2 };
    }
    var ac = { x: A.x + A.w / 2, y: A.y + A.h / 2 }, bc = { x: B.x + B.w / 2, y: B.y + B.h / 2 };
    var horizontal = Math.abs(bc.x - ac.x) * H > Math.abs(bc.y - ac.y) * W;
    var p1, p2;
    if (horizontal) { p1 = { x: bc.x > ac.x ? A.x + A.w : A.x, y: ac.y }; p2 = { x: bc.x > ac.x ? B.x : B.x + B.w, y: bc.y }; }
    else { p1 = { x: ac.x, y: bc.y > ac.y ? A.y + A.h : A.y }; p2 = { x: bc.x, y: bc.y > ac.y ? B.y : B.y + B.h }; }
    return { d: 'M' + p1.x + ',' + p1.y + ' L' + p2.x + ',' + p2.y, mx: (p1.x + p2.x) / 2, my: (p1.y + p2.y) / 2 };
  }

  function renderEdgesAndGroups() {
    clear(layerGroups); clear(layerEdges);
    var nodes = S.canvas.nodes;
    Object.keys(S.canvas.groups).forEach(function (gid) {
      var grp = S.canvas.groups[gid];
      var ms = grp.members.map(function (id) { return nodes[id]; }).filter(Boolean);
      if (!ms.length) return;
      var minX = Math.min.apply(null, ms.map(function (n) { return n.x; })) - 18, minY = Math.min.apply(null, ms.map(function (n) { return n.y; })) - 40;
      var maxX = Math.max.apply(null, ms.map(function (n) { return n.x + W; })) + 18, maxY = Math.max.apply(null, ms.map(function (n) { return n.y + H; })) + 18;
      var g = svg('g', { 'class': 'group ' + grp.kind }, layerGroups);
      svg('rect', { x: minX, y: minY, width: maxX - minX, height: maxY - minY, rx: 14 }, g);
      svg('text', { x: minX + 14, y: minY + 22 }, g, grp.label);
    });
    Object.keys(S.canvas.edges).forEach(function (eid) {
      var e = S.canvas.edges[eid], a = nodes[e.from], b = nodes[e.to];
      if (!a || !b) return;
      var p = edgePath(a, b, e.kind);
      svg('path', { 'class': 'edge ' + e.kind, d: p.d, 'marker-end': 'url(#arrow)' }, layerEdges);
      if (e.label) svg('text', { 'class': 'edgelabel', x: p.mx, y: p.my - 4 }, layerEdges, e.label);
    });
  }

  function positionNodes() {
    Object.keys(nodeEls).forEach(function (id) {
      var n = S.canvas.nodes[id];
      if (n) nodeEls[id].setAttribute('transform', 'translate(' + n.x + ',' + n.y + ')');
    });
    renderEdgesAndGroups();
  }

  function renderBoard() {
    clear(layerNodes); nodeEls = {};
    Object.keys(S.canvas.nodes).map(function (id) { return S.canvas.nodes[id]; })
      .sort(function (a, b) { return a.seq - b.seq; })
      .forEach(function (n) { nodeEls[n.id] = drawNode(n); });
    renderEdgesAndGroups();
    applySelection();
    applyTransform();
    $('empty').hidden = Object.keys(S.canvas.nodes).length > 0;
  }

  function applySelection() {
    Object.keys(nodeEls).forEach(function (id) {
      var g = nodeEls[id];
      g.setAttribute('class', 'node n-' + S.canvas.nodes[id].type + (S.selection[id] ? ' selected' : ''));
      var old = g.querySelectorAll('.peersel');
      for (var i = 0; i < old.length; i++) g.removeChild(old[i]);
    });
    Object.keys(S.peerSel).forEach(function (pid) {
      var peer = S.peers[pid];
      if (!peer) return;
      (S.peerSel[pid] || []).forEach(function (id) {
        if (nodeEls[id]) svg('rect', { 'class': 'peersel', x: -3, y: -3, width: W + 6, height: H + 6, rx: 12, stroke: peer.color }, nodeEls[id]);
      });
    });
  }

  function renderCursors() {
    clear(layerCursors);
    var t = now();
Object.keys(S.cursors).forEach(function (id) {
      var c = S.cursors[id], peer = S.peers[id];
      if (!peer || t - c.t > 6000) return;
      var g = svg('g', { 'class': 'cursor', transform: 'translate(' + c.x + ',' + c.y + ') scale(' + (1 / S.view.k) + ')' }, layerCursors);
      svg('path', { d: 'M0,0 L0,17 L4.5,13 L7.5,20 L10,19 L7,12 L13,12 z', fill: peer.color }, g);
      var label = peer.name.length > 14 ? peer.name.slice(0, 13) + '\u2026' : peer.name;
      svg('rect', { x: 14, y: 14, width: label.length * 7 + 10, height: 17, rx: 8, fill: peer.color }, g);
      svg('text', { x: 19, y: 26 }, g, label);
    });
  }

  // ---------------------------------------------------------------- selection and editing
  function selIds() { return Object.keys(S.selection); }
  function setSel(ids) {
    S.selection = {}; ids.forEach(function (id) { S.selection[id] = true; });
    applySelection(); send({ t: 'select', ids: ids });
  }
  function toggleSel(id) {
    if (S.selection[id]) delete S.selection[id]; else S.selection[id] = true;
    applySelection(); send({ t: 'select', ids: selIds() });
  }

  var drag = null, moveTimer = null, lastCursor = 0;
  function sendCursor(p) {
    var t = now();
    if (t - lastCursor < 50) return;
    lastCursor = t;
    send({ t: 'cursor', x: Math.round(p.x), y: Math.round(p.y) });
  }
  function flushMoves() {
    if (moveTimer) { clearTimeout(moveTimer); moveTimer = null; }
    if (!drag || drag.mode !== 'node') return;
    var ops = [];
    Object.keys(drag.orig).forEach(function (id) { var n = S.canvas.nodes[id]; if (n) ops.push({ op: 'moveNode', id: id, x: Math.round(n.x), y: Math.round(n.y) }); });
    if (ops.length) send({ t: 'ops', ops: ops });
  }
  function onDown(e) {
    if (e.button !== undefined && e.button !== 0) return;
    var el = e.target && e.target.closest ? e.target.closest('.node') : null;
    var p = toCanvas(e);
    if (el) {
      var id = el.getAttribute('data-id');
