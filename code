    $('log').scrollTop = $('log').scrollHeight;
    return line;
  }
  function renderLog() { clear($('log')); S.transcript.forEach(addLogLine); }

  // ---------------------------------------------------------------- speech to canvas
  function toggleTranscribe() {
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
