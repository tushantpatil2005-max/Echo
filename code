  }

  // ---------------------------------------------------------------- video and audio (peer to peer)
  function renderTiles() {
    var box = $('videos');
    var wanted = {};
    if (S.me) wanted[S.me.id] = true;
    Object.keys(S.peers).forEach(function (id) { wanted[id] = true; });
    Object.keys(S.tiles).forEach(function (id) { if (!wanted[id]) { box.removeChild(S.tiles[id].el); delete S.tiles[id]; } });
    Object.keys(wanted).forEach(function (id) {
      var info = S.me && id === S.me.id ? S.me : S.peers[id];
      var t = S.tiles[id];
      if (!t) {
        var el = html('div', 'tile', box);
        var video = html('video', '', el);
        video.autoplay = true; video.playsInline = true; video.muted = !!(S.me && id === S.me.id);
        var avatar = html('span', 'avatar', el);
        var who = html('span', 'who', el);
        t = S.tiles[id] = { el: el, video: video, avatar: avatar, who: who };
      }
      t.avatar.textContent = initial(info.name);
      t.who.textContent = info.name + (S.me && id === S.me.id ? ' (you)' : '') + (info.media && !info.media.audio && !(S.me && id === S.me.id) ? ' \u00b7 mic off' : '');
