if (require.main === module) {
  const app = createServer();
  app.listen().then((port) => {
    log('listening', { url: `http://${app.cfg.host}:${port}`, dataDir: app.cfg.dataDir, remoteInterpreter: !!app.cfg.interpreter.url });
    if (!['127.0.0.1', 'localhost', '::1'].includes(app.cfg.host)) log('warning', { message: 'Listening on a public address without TLS: put a reverse proxy with HTTPS in front (browsers need HTTPS for camera and microphone).' });
  });
  const stop = () => app.close().then(() => process.exit(0));
  process.on('SIGINT', stop);
  process.on('SIGTERM', stop);
