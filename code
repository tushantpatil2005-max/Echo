    r.onend = function () { if (S.micOn) { try { r.start(); } catch (e) { /* will retry on next toggle */ } } };
    r.onerror = function (ev) {
      if (ev.error === 'not-allowed' || ev.error === 'service-not-allowed') { S.micOn = false; btn.className = ''; addLocalLine('Microphone access was blocked, so transcription is off.'); }
    };
