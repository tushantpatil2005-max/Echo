  function addLogLine(entry) {
    var log = $('log');
var line = html('div', 'line ' + entry.kind, log);
    html('span', 'sp', line, entry.speaker + (entry.kind === 'command' ? ' (to Echo)' : ''));
    html('span', 'tx', line, entry.text);
